{
  "name": "rsvp-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event RSVP web app",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "node --experimental-strip-types --watch src/server/main.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types src/server/main.ts",
    "test": "vitest run --project unit --project component --project contract --project architecture",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:contract": "vitest run --project contract",
    "test:architecture": "vitest run --project architecture",
    "test:coverage": "vitest run --coverage --project unit --project component --project contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:gate": "vitest run --project gate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:component && npm run test:contract && npm run test:architecture && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
